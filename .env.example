# Copy this file to ".env.local" and fill in the values. ".env.local" is never committed to git.
# Without these two lines the site still works: it shows the local test data from data/seed/.

# Supabase -> your project -> Project Settings -> API
# "Project URL", looks like https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (starts with sb_publishable_...). On older projects it is called
# "anon public" key - it works the same. It is SAFE to be public: the database rules
# (Row Level Security) decide what it may read.
# NEVER put the "secret" / "service_role" key here or anywhere in the front end.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public contact address shown on the Contact page (optional).
NEXT_PUBLIC_CONTACT_EMAIL=

# SECRET. Only for the loading scripts in scripts/ that you run on your own computer
# (node scripts/load-institutions.mjs). Supabase -> Project Settings -> API -> "secret" / "service_role" key.
# NEVER put it in a variable that starts with NEXT_PUBLIC_, never commit it, never send it to anyone.
SUPABASE_SERVICE_ROLE_KEY=
