{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourhei",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "yourhei" }],
  // The cache of the pages that refresh on a timer (create the bucket once: see docs/CLOUDFLARE.md)
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "yourhei-cache" }],
  // The queue that rebuilds old pages in the background
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "observability": { "enabled": true }
}
